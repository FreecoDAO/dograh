# Dograh — Environment Configuration Template
#
# Copy to .env and fill in all values BEFORE running start_docker.sh.
# All secrets marked with [REQUIRED] must be set — the application will
# refuse to start without them.
#
# Generate strong secrets with:
#   openssl rand -base64 32    (for tokens/keys)
#   openssl rand -hex 16       (for passwords)
#
# NEVER commit your .env file to git.

# ===========================================
# ENVIRONMENT
# ===========================================

# local | remote
# Use "remote" for production deployments with nginx + TLS + TURn
ENVIRONMENT=local

# ===========================================
# SECRETS — [REQUIRED] No defaults. Generate strong values.
# ===========================================

# JWT secret for authentication tokens
# Generate: openssl rand -base64 32
OSS_JWT_SECRET=

# PostgreSQL password — NO default. Must be set.
# Note: Changing this on an existing install does NOT re-key the database.
# The password is baked into the volume on first init.
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# Redis password — NO default. Must be set.
# Generate: openssl rand -hex 16
REDIS_PASSWORD=

# MinIO root credentials — NO default. Must be set.
# Generate: openssl rand -hex 8 (user), openssl rand -base64 24 (password)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# TURn secret for WebRTC NAT traversal (remote deployments only)
# Generate: openssl rand -base64 32
TURn_SECRET=

# ===========================================
# PUBLIC ENDPOINTS (remote deployments)
# ===========================================

# The public URL users access (e.g. https://voice.fre.eco)
PUBLIC_BASE_URL=

# The public hostname (e.g. voice.fre.eco)
PUBLIC_HOST=

# Server IP for TURn configuration
SERVER_IP=

# ===========================================
# TELEMETRY — Disabled by default. Opt-in only.
# ===========================================

# Set to "true" to send anonymous usage data to PostHog.
# WARNING: When enabled, set POSTHOG_API_KEY to your own project key.
# The upstream hardcoded key has been removed for privacy.
ENABLE_TELEMETRY=false

# Your own PostHog project key (only used if ENABLE_TELEMETRY=true)
# POSTHOG_API_KEY=

# ===========================================
# TRUSTED PROXIES
# ===========================================

# Comma-separated list of IPs/CIDRs trusted for X-Forwarded-* headers.
# Default: Docker bridge subnet. Narrow this for your network.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# ===========================================
# OPTIONAL: S3 Storage (replaces bundled MinIO)
# ===========================================

# ENABLE_AWS_S3=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=

# ===========================================
# OPTIONAL: Cloudflare Tunnel (for NAT traversal without public IP)
# ===========================================

# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_COMMAND=tunnel run

# ===========================================
# OPTIONAL: Langfuse Tracing
# ===========================================

# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=

# ===========================================
# APPLICATION
# ===========================================

# Enable/disable public signup (set to false for invite-only)
ENABLE_SIGNUP=true

# Number of uvicorn workers (each binds a distinct port starting at 8000)
FASTAPI_WORKERS=1
